generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GmailAccount {
  id            String       @id @default(cuid())
  userId        String       @unique
  email         String
  accessToken   String
  refreshToken  String?
  tokenExpiry   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  scanResults      ScanResult[]
  driveScanResults DriveScanResult[]
  photoScanResults PhotoScanResult[]
  cleanupSchedules CleanupSchedule[]
  cleanupReports   CleanupReport[]
}

model ScanResult {
  id            String          @id @default(cuid())
  accountId     String
  category      String
  senderEmail   String
  senderName    String?
  subject       String?
  threadId      String
  messageIds    String
  emailCount    Int             @default(1)
  lastReceived  DateTime?
  unsubscribeUrl String?
  importanceScore Float?
  scannedAt     DateTime        @default(now())

  account       GmailAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cleanupActions CleanupAction[]

  @@index([accountId])
  @@index([category])
}

model CleanupAction {
  id            String      @id @default(cuid())
  scanResultId  String
  action        String
  messageIds    String
  performedAt   DateTime    @default(now())

  scanResult    ScanResult  @relation(fields: [scanResultId], references: [id], onDelete: Cascade)

  @@index([scanResultId])
}

model DriveScanResult {
  id             String   @id @default(cuid())
  accountId      String
  fileId         String   @unique
  fileName       String
  mimeType       String
  fileSize       Int      @default(0)
  createdTime    String
  modifiedTime   String
  trashed        Boolean  @default(false)
  webViewLink    String
  sharedWithMe   Boolean  @default(false)
  ownerEmail     String?
  importanceScore Float?
  hashSignature  String?
  scannedAt      DateTime @default(now())

  account        GmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([hashSignature])
}

model PhotoScanResult {
  id            String   @id @default(cuid())
  accountId     String
  photoId       String   @unique
  filename      String
  mimeType      String
  fileSize      Int      @default(0)
  width         Int      @default(0)
  height        Int      @default(0)
  creationTime  String
  baseUrl       String
  isFavorite    Boolean  @default(false)
  hashSignature String?
  scannedAt     DateTime @default(now())

  account       GmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([hashSignature])
}

model CrossServiceDuplicate {
  id              String   @id @default(cuid())
  accountId       String
  hashSignature   String
  services        String
  fileName        String
  fileSize        Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([accountId])
  @@index([hashSignature])
}

model CleanupSchedule {
  id          String   @id @default(cuid())
  accountId   String
  name        String
  enabled     Boolean  @default(true)
  frequency   String   @default("weekly")
  rules       String
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  totalCleaned Int      @default(0)
  totalSaved   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account     GmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model CleanupReport {
  id          String   @id @default(cuid())
  accountId   String
  reportType  String
  title       String
  summary     String
  stats       String
  createdAt   DateTime @default(now())

  account     GmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}
